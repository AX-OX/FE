# Spring API 주소. 프론트 환경 변수에는 접속 주소만 넣는다 (JWT_SECRET·INTERNAL_TOKEN 등은 넣지 않는다)
#  - 비워두면 같은 origin(/api)으로 요청하고, 개발 서버에서는 vite proxy가 백엔드로 넘긴다 (CORS 설정 불필요)
#  - 직접 연결하려면 http://localhost:8080 처럼 적고, 백엔드 CORS_ORIGIN에 이 프론트 주소(예: http://localhost:5173)를 넣어 재시작한다
#  - 경로에 /api를 중복해서 넣지 않는다
VITE_API_BASE_URL=
# vite dev proxy 대상 (VITE_API_BASE_URL이 비었을 때만 사용)
VITE_DEV_PROXY_TARGET=http://localhost:8080
# true면 백엔드 없이 mock 응답 사용 (시연 계정: demo@ax-navigator.com / demo1234!)
# 실제 백엔드 연결 시 false (시드 계정: analyst1@gaon.example / ChangeMe123!)
VITE_USE_MOCK=false
